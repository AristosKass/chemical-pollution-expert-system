(defclass Acid
	(is-a Chemical)
	(role abstract))

(defclass StrongAcid
	(is-a Acid)
	(role concrete))

(defclass WeakAcid
	(is-a Acid)
	(role concrete))

(defclass Base
	(is-a Chemical)
	(role abstract))

(defclass StrongBase
	(is-a Base)
	(role concrete))

(defclass WeakBase
	(is-a Base)
	(role concrete))

(defclass Oil
	(is-a Chemical)
	(role concrete))

(defclass Store
	(is-a USER)
	(role concrete)
	(single-slot connectedManhole
		(type INSTANCE)
;+		(allowed-classes Manhole)
;+		(cardinality 0 1)
		(create-accessor read-write))
	(multislot containsChemical
		(type INSTANCE)
;+		(allowed-classes Chemical)
		(create-accessor read-write)))

(defclass SewerNode
	(is-a USER)
	(role abstract))

(defclass Manhole
	(is-a SewerNode)
	(role concrete)
	(single-slot downstream
		(type INSTANCE)
;+		(allowed-classes SewerNode)
;+		(cardinality 0 1)
		(create-accessor read-write)))

(defclass MonitoringStation
	(is-a SewerNode)
	(role concrete)
	(single-slot stationName
		(type STRING)
;+		(cardinality 0 1)
		(create-accessor read-write)))